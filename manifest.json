{
  "manifest_version": 3,
  "name": "LinkedIn Job Text Copier / Fast Apply Panel",
  "description": "Review LinkedIn jobs, open Apply, copy descriptions, save to Google Sheets and send to ChatGPT from one panel.",
  "version": "0.5.4",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "clipboardRead",
    "clipboardWrite",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.linkedin.com/jobs/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://docs.google.com/spreadsheets/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/spreadsheets/*"
      ],
      "js": [
        "sheets.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "chatgpt.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
